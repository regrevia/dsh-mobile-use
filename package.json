{
  "name": "dsh-mobile-use",
  "version": "1.1.1",
  "private": false,
  "description": "真机调试插件：界面文本树、动效数据、实时画面侧栏与圈选标注",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./mirror": "./mirror.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "index.js",
    "mirror.js",
    "client.js",
    "client.rev",
    "stream.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor",
    "README.md",
    "selftest.mjs",
    "ocr.js",
    "ocr_worker.py",
    ".env.example",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "test"
  ],
  "license": "MIT",
  "author": "dsh-mobile-use contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/regrevia/dsh-mobile-use"
  },
  "homepage": "https://github.com/regrevia/dsh-mobile-use#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-mobile-use/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "adb",
    "android",
    "uiautomator",
    "mirror",
    "debugging"
  ],
  "scripts": {
    "test": "node test/coords.test.mjs && node test/symbols.test.mjs && node test/timers.test.mjs && node test/classifier.test.mjs"
  }
}
